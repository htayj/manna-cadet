(layout expansive
  (dimensions
    (case (default normal) (states normal shift))
    (alphabet (default latin) (states latin greek))
    (surface (default base) (states base top))
    (mode (default text) (states text command number))
    (group (default primary) (states primary secondary tertiary quaternary)))
  (levels
    (plain (selectors))
    (raised (selectors (case shift)) (fallback plain))
    (lowered (selectors (alphabet greek)) (fallback plain))
    (letters (selectors (surface top)))
    (marks (selectors (mode command)) (fallback raised))
    (numbers (selectors (mode number)))
    (navigation (selectors (group secondary)) (fallback plain))
    (editing (selectors (case shift) (mode command)))
    (window (selectors (alphabet greek) (group secondary)))
    (application (selectors (surface top) (mode command)))
    (greek (selectors (alphabet greek) (surface top) (group tertiary)))
    (math (selectors (alphabet greek) (mode number)) (fallback numbers))
    (logic (selectors (case shift) (group tertiary)))
    (sets (selectors (alphabet greek) (surface top)))
    (arrows (selectors (mode number) (group secondary)) (fallback navigation))
    (music (selectors (case shift) (alphabet greek) (mode command)))
    (phonetic (selectors (surface top) (group quaternary)))
    (currency (selectors (case shift) (surface top) (mode number)))
    (technical (selectors (alphabet greek) (mode command) (group tertiary)))
    (custom (selectors (case shift) (alphabet greek) (surface top)
                       (mode number) (group quaternary))
            (fallback technical)))
  (layers (root root) (layer fun))
  (modifiers (shift control meta super hyper alt graph compose))
  (commands (dispatch cancel))
  (symbols alpha (Alpha "A") beta)
  (keys
    (key primary
      ((root plain) alpha)
      ((root raised) (symbol Alpha))
      ((root custom) (mods shift control meta super hyper alt graph compose))
      ((fun plain) (command dispatch)))
    (key selector
      ((root plain)
       (tap-hold beta
         (simultaneous (mods shift) (hold-selector case shift))))
      ((root navigation) transparent)
      ((root editing) none))
    (key layer-key ((root plain) (layer-hold fun))))
  (combos
    (combo (primary selector) ((root plain) (command cancel)))))
