#| --------------------------------------------------------------------------

                         kanata: Kinesis Advantage 360 (layered Space Cadet)

   Active host: basedserv. Bound to the Adv360 evdev node via `linux-dev'
   below; `kb_setup.sh' picks this file when $HOSTNAME == basedserv.

   The `defsrc' layer below mirrors the Advantage 360's physical layout
   (split halves + thumb clusters). Copy a `deflayer' template to add a
   new layer with matching `transparent' buttons (`_').

(deflayer name
  _    _    _    _                             _    _    _    _    _    _    _
       _    _    _    _    _    _    _    _    _    _    _    _         _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _         _
  _    _    _    _    _    _    _    _    _    _    _    _    _         _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _              _
  _    _    _    _              _              _    _    _         _    _    _
                                                                   _    _    _
)

layout: {zmk_keyboard: adv360}
  -------------------------------------------------------------------------- |#


;; (deflocalkeys-sun
;;   F18 247
;; 	F19 138
;; 	F20 248
;; 	F21 142)
;; US
(defsrc
  =      1    2    3    4    5    			        6    7    8    9    0    -  
  tab    q    w    e    r    t F18          F20 y    u    i    o    p     \
  esc    a    s    d    f    g F19          F21 h    j    k    l    ;     ' 
  lshift z    x    c    v    b                  n    m    ,    .    /     rshift
	       grv  caps left right                   up   down [    ]

             lctl  lalt                rmet rctl
						       home                pgup
        bspc del   end                 pgdn ent spc
 																																	 
)

;; press both to latch?
(defalias
  ;; homerow mod
  Sf (tap-hold-release 200 200 f lshift)       ;; left homerow shift
  Cd (tap-hold-release 200 200 d lctl)         ;; left homerow ctrl
  Ms (tap-hold-release 200 200 s lalt)         ;; left homerow meta
  sa (tap-hold-release 250 250 a lmet)         ;; left homehow super
  Sj (tap-hold-release 200 200 j lshift)       ;; right homerow shift
  Ck (tap-hold-release 200 200 k lctl)         ;; right homerow ctrl
  Ml (tap-hold-release 200 200 l lalt)         ;; right homerow meta
  s; (tap-hold-release 200 200 ; lmet)         ;; right homerow super
  Hro (tap-hold-release 200 200 bspc ralt)     ;; left thumb alt
  Hsp (tap-hold-release 200 200 spc  ralt)     ;; right thumb alt
  HscL (tap-hold-release 200 200 end  (layer-while-held fun))       ;; tap End, hold function layer
  HscR (tap-hold-release 200 200 pgdn (layer-while-held fun))       ;; tap PgDn, hold function layer
;;  Tr (tap-next-release r (layer-toggle top))         ;; left homerow top
;;  Tu (tap-next-release u (layer-toggle top))         ;; right homerow super
  ;; other mod keys
  eoam (tap-hold-release 200 200 esc rmet)    ;; escape / hyper mode
  qoam (tap-hold-release 200 200 ' rmet)       ;; quote / hyper mode
  osft (tap-hold-release 200 200 0 lshift)    ;; open round / shift
  csft (tap-hold-release 200 200 0 rshift)    ;; close round / shift

  ;; greek
	gr  (arbitrary-code 85) ;; modeswitch
	top (arbitrary-code 84) ;; iso level 3
	rtop (tap-hold-release 200 200 ent @top)
	gdel (tap-hold-release 200 200 del @gr)

  ;; Space Cadet command keysyms (emitted via spare evdev keycodes;
  ;; the XKB layout maps each keycode to the actual command keysym).
	sc-macro       (arbitrary-code 183) ;; -> UE000
	sc-terminal    (arbitrary-code 184) ;; -> UE001
	sc-quote       (arbitrary-code 185) ;; -> UE002
	sc-overstrike  (arbitrary-code 186) ;; -> UE003
	sc-clearinput  (arbitrary-code 187) ;; -> UE004
	sc-clearscreen (arbitrary-code 188) ;; -> UE005
	sc-holdoutput  (arbitrary-code 189) ;; -> UE006
	sc-stopoutput  (arbitrary-code 190) ;; -> UE007
	sc-abort       (arbitrary-code 191) ;; -> UE008
	sc-break       (arbitrary-code 192) ;; -> UE009
	sc-system      (arbitrary-code 195) ;; -> UE00A
	sc-network     (arbitrary-code 196) ;; -> UE00B
	sc-call        (arbitrary-code 194) ;; -> UE00C
	sc-end         (arbitrary-code 240) ;; -> UE00D
	sc-i           (arbitrary-code 218) ;; -> U2160
	sc-ii          (arbitrary-code 219) ;; -> U2161
	sc-iii         (arbitrary-code 220) ;; -> U2162
	sc-iv          (arbitrary-code 221) ;; -> U2163
	sc-fingerleft  (arbitrary-code 222) ;; -> U261A
	sc-thumbup     (arbitrary-code 223) ;; -> U1F44D
	sc-thumbdown   (arbitrary-code 224) ;; -> U1F44E
	sc-fingerright (arbitrary-code 225) ;; -> U261B
	sc-repeat      (arbitrary-code 226) ;; -> UE00E
	sc-altmode     (arbitrary-code 211) ;; -> UE00F
	sc-modelock    (arbitrary-code 212) ;; -> UE010
	sc-resume      (arbitrary-code 193) ;; -> UE011
	sc-status      (arbitrary-code 197) ;; -> UE012
	sc-line        (arbitrary-code 198) ;; -> UE013
	sc-help        (arbitrary-code 199) ;; KEY_HELP -> UE014
)

;; Space Cadet chords are exposed in this variant via one held thumb layer:
;; hold End or PgDn for the function layer. Left half uses each former
;; chord's left trigger; right half uses each former chord's right trigger.
(deflayer normal
  =      1    2    3    4    5    	    		6    7    8    9    0    -  
  tab    q    w    e    r    t F18      F20 y    u    i    o    p     \
  @eoam  @sa  @Ms  @Cd  @Sf  g F19      F21 h    @Sj  @Ck  @Ml  @s;   @qoam
  lshift z    x    c    v    b              n    m    ,    .    /     rshift
	       grv  caps left right               up   down [    ]

                  @gr   lrld                rmet  @top
		     			          home                pgup
             @Hro @gdel @HscL               @HscR @rtop @Hsp
)
(deflayer fun
  _    @sc-i @sc-ii @sc-iii @sc-iv _              _    @sc-fingerleft @sc-thumbup @sc-thumbdown @sc-fingerright _
  _    @sc-quote @sc-terminal @sc-macro _    @sc-overstrike _    _    _    @sc-status @sc-call @sc-stopoutput _    _
  _    _    @sc-system _    _    @sc-abort _    _    @sc-help @sc-line @sc-clearinput @sc-clearscreen @sc-end _
  _    @sc-holdoutput @sc-network @sc-break _    _          _    @sc-resume _    @sc-repeat _    _
       @sc-modelock @sc-altmode _    _             _    _    _    _
                  _    _                   _    _
                                      _                   _
             _    _    _                   _    _    _
)
;;(deflayer modelatch)
;; (deflayer greek
;;   esc  mute vold volu                          prnt slck pause home end ins del  
;;         f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12     
;;   grv   1    2    3    4    5    6    7    8    9    0    -     =        bspc
;;   tab   q    w    e    r    t    y    u    i    o    p    [     ]        \
;;   @roam @sa  @Ms  @Cd  @Sf  g    h    @Sj  @Ck  @Ml  @s;  @qoam          ret
;;   @osf  z    x    c    v    b    n    m    ,    .    /                  @csft
;;   wkup  lctl lmet lalt           spc            ralt cmps rctl      pgup up   pgdn
;;                                                                    left down rght
;; )
;;(deflayer top)
(defcfg
    linux-dev /dev/input/by-id/usb-Kinesis_Kinesis_Adv360_360555127546-if01-event-kbd
    process-unmapped-keys yes
    concurrent-tap-hold yes)

