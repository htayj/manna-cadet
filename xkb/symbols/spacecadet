// ---------------------------------------------------------------------------
// The combined two-group keymap, composed from the parts above so there is a
// single source of truth. This is what keymap/spacecadet.xkb includes, and it
// compiles byte-identically to the pre-split version.
// ---------------------------------------------------------------------------
partial alphanumeric_keys modifier_keys
xkb_symbols "base" {
    include "spacecadet(g1)"
    include "spacecadet(top):2"
};

default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {
    include "spacecadet(base)"
};
